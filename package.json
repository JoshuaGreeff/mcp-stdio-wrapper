{
  "name": "mcp-stdio-wrapper",
  "version": "0.1.1",
  "description": "Development-first MCP wrapper for smoke-testing stdio MCP servers from another MCP client during active development.",
  "type": "module",
  "license": "MIT",
  "author": "Joshua Greeff",
  "packageManager": "npm@11.11.1",
  "homepage": "https://github.com/JoshuaGreeff/mcp-stdio-wrapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaGreeff/mcp-stdio-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/JoshuaGreeff/mcp-stdio-wrapper/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stdio",
    "testing",
    "smoke-test",
    "developer-tools",
    "cursor",
    "codex"
  ],
  "bin": {
    "mcp-stdio-wrapper": "index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "start": "node index.mjs",
    "check": "node --check index.mjs && node --check lib/core.mjs && node --check tests/fake-target.mjs && node --check tests/wrapper.test.mjs && node --check tests/fuzz.test.mjs",
    "test": "node --test tests/wrapper.test.mjs tests/fuzz.test.mjs",
    "test:fuzz": "node --test tests/fuzz.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "fast-check": "^4.6.0"
  }
}
